# Exact Online OAuth2 credentials
# Registreer je app op https://apps.exactonline.com
EXACT_CLIENT_ID=your_client_id_here
EXACT_CLIENT_SECRET=your_client_secret_here

# Redirect URI (moet overeenkomen met wat je bij Exact hebt ingesteld)
EXACT_REDIRECT_URI=http://localhost:8000/auth/callback

# Exact Online base URL (NL versie)
EXACT_BASE_URL=https://start.exactonline.nl

# Token opslag pad (bestand voor persistentie van access/refresh tokens)
TOKEN_FILE=.tokens.json
